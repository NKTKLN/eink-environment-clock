# ESP32-C3 Super Mini: console over the native USB Serial/JTAG port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA: boot the new image once, roll back unless it confirms itself
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Wi-Fi and IP event handlers run on this task; the default 2304 bytes left
# only ~120 bytes free in a soak test.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# HTTP server: longer headers (browsers send many), more URI handlers
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Keep debug messages in the image so the web log level switch can turn
# them on; the default level stays info.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

CONFIG_LWIP_LOCAL_HOSTNAME="eink-clock"
# HTTP server (5 + 3 internal), captive DNS, MQTT, mDNS
CONFIG_LWIP_MAX_SOCKETS=16

# Weak link: keep more TCP segments in flight so a lossy Wi-Fi link can still
# push the ~32 KB page before the HTTP send timeout fires (defaults: 5760).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
# Larger receive window helps OTA uploads and POST bodies over the same link.
CONFIG_LWIP_TCP_WND_DEFAULT=16384
